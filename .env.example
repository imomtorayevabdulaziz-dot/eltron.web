# ==========================================
# SUPABASE (Baza va Autentifikatsiya)
# ==========================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ==========================================
# YANDEX CLOUD S3 (Rasmlar va Media saqlash)
# ==========================================
YANDEX_S3_ACCESS_KEY=your_yandex_s3_access_key
YANDEX_S3_SECRET_KEY=your_yandex_s3_secret_key
YANDEX_S3_BUCKET=your_bucket_name
YANDEX_S3_REGION=ru-central1

# ==========================================
# YANDEX MAPS
# ==========================================
NEXT_PUBLIC_YANDEX_MAPS_API_KEY=your_yandex_maps_api_key

# ==========================================
# YANDEX DELIVERY (Ixtiyoriy)
# ==========================================
YANDEX_DELIVERY_TOKEN=your_delivery_token

# ==========================================
# AI (GROQ)
# ==========================================
GROQ_API_KEY_1=your_groq_api_key_1
GROQ_API_KEY_2=your_groq_api_key_2

# ==========================================
# ANALYTICS
# ==========================================
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
NEXT_PUBLIC_YM_ID=12345678

# ==========================================
# ADMIN AUTH & XAVFSIZLIK
# ==========================================
ADMIN_LOGIN=admin
ADMIN_PASSWORD=your_secure_password
ADMIN_SECRET=your_random_secret_32_chars
JWT_SECRET=your_jwt_secret_32_chars

# ==========================================
# TELEGRAM BOTLAR VA ADMIN BOG'LANISHI
# ==========================================
TELEGRAM_CUSTOMER_BOT_TOKEN=your_customer_bot_token
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=your_bot_username
NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app
TELEGRAM_ADMIN_BOT_TOKEN=your_admin_bot_token
TELEGRAM_ADMIN_ID=your_admin_chat_id
TELEGRAM_CHAT_ID=your_admin_chat_id

# ==========================================
# TO'LOV TIZIMI (CLICK)
# ==========================================
CLICK_SECRET_KEY=
CLICK_MERCHANT_PASSWORD=
CLICK_MERCHANT_USER=
NEXT_PUBLIC_CLICK_MERCHANT_ID=
NEXT_PUBLIC_CLICK_SERVICE_ID=
